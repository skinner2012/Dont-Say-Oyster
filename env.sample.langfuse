# Copy to infra/langfuse/.env and replace every CHANGEME. docker compose reads that file from
# its project directory. Generate secrets with: openssl rand -hex 32
#
# Headless initialization: created on first start if they do not exist. The key pair below is
# the same pair the repo-root .env carries as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_ORG_ID=oyster-org
LANGFUSE_INIT_ORG_NAME=Oyster
LANGFUSE_INIT_PROJECT_ID=oyster-proj
LANGFUSE_INIT_PROJECT_NAME=Dont-Say-Oyster
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=Author
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
#
# Application secrets.
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
#
# Data stores. The upstream compose file defaults these to weak values.
# DATABASE_URL embeds the Postgres password: keep the two in step.
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
# The three S3 access key ids default to the MinIO root user, so the three S3 secrets must
# equal MINIO_ROOT_PASSWORD.
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME
